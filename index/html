<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>Nightbound — A Choice Story</title>
<style>
:root{--bg:#0b0910;--panel:#15111c;--panel2:#1d1726;--text:#eee9f4;--muted:#aaa0b5;--accent:#b978ff;--accent2:#6e43a0;--danger:#e46a8b}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at top,#21152e 0,#0b0910 48%);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh}
button{font:inherit}.app{max-width:720px;margin:auto;min-height:100vh;padding:18px}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.brand{font-weight:800;letter-spacing:1px}.day{font-size:13px;color:var(--muted)}
.card{background:rgba(21,17,28,.94);border:1px solid #30263a;border-radius:20px;overflow:hidden;box-shadow:0 16px 45px #0008}
.hero{height:300px;background:linear-gradient(180deg,#292033,#100d15);display:flex;align-items:flex-end;justify-content:center;position:relative}
.hero .portrait{width:150px;height:210px;border-radius:75px 75px 20px 20px;background:linear-gradient(145deg,#2b1b39,#08070b);border:2px solid #8052a7;box-shadow:0 0 50px #8f54c855;display:flex;align-items:center;justify-content:center;color:#c9a9e9;font-size:64px}
.hero .label{position:absolute;bottom:12px;left:16px;background:#08070bcc;padding:7px 10px;border-radius:10px;font-size:12px;color:#d9cce3}
.content{padding:20px}.speaker{color:var(--accent);font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:1px}.title{font-size:25px;margin:6px 0 10px}.text{line-height:1.65;color:#e7e0eb;white-space:pre-line}
.choices{display:grid;gap:10px;margin-top:20px}.choice{border:1px solid #443650;background:var(--panel2);color:var(--text);padding:14px;border-radius:13px;text-align:left;cursor:pointer;transition:.15s}.choice:hover{border-color:var(--accent);transform:translateY(-1px)}
.choice small{display:block;color:var(--muted);margin-top:5px}
.toolbar{display:flex;gap:8px;margin-top:14px}.tool{flex:1;padding:10px;border-radius:11px;border:1px solid #3a3042;background:#120f17;color:#ddd;cursor:pointer}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:12px 0}.stat{background:#120f17;border:1px solid #30263a;border-radius:12px;padding:9px}.stat b{display:block;font-size:16px}.stat span{font-size:11px;color:var(--muted)}
.menu{display:grid;gap:10px;margin-top:20px}.primary{background:var(--accent2);border:0;color:white;padding:14px;border-radius:13px;font-weight:700;cursor:pointer}.secondary{background:#19141f;border:1px solid #3a3042;color:#ddd;padding:12px;border-radius:13px;cursor:pointer}
.note{font-size:12px;color:var(--muted);line-height:1.5;margin-top:14px}
@media(max-width:500px){.app{padding:10px}.hero{height:260px}.content{padding:16px}.stats{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<div class="app">
<header><div class="brand">NIGHTBOUND</div><div class="day" id="day"></div></header>
<div id="root"></div>
</div>
<script>
const KEY="nightbound_save_v1";

const baseState=()=>({
 scene:"intro", day:1, money:120, courage:5, trust:0, submission:0, reputation:0,
 inventory:[], flags:{metLuna:false, club:false, outfit:false}, history:[]
});

let state=load()||baseState();

const scenes={
intro:{
 speaker:"Narrator", title:"A New Start",
 text:`Steven arrived at the university with one suitcase, a half-charged phone, and no idea what the next few months would look like.

The campus was larger than he expected. New faces filled the walkways, clubs advertised themselves everywhere, and the evening seemed to carry its own set of rules.

Then he noticed her.

A woman in black stood beneath the old library lights, calmly watching the crowd.`,
 choices:[
  {label:"Walk over and introduce yourself.",effect:{courage:1},next:"meet"},
  {label:"Keep your distance and observe.",effect:{reputation:1},next:"observe"}
 ]},
meet:{
 speaker:"Luna",title:"Luna",
 text:`"You're new."

Her voice was calm, almost amused.

Steven nodded. "First week."

"Luna." She offered her name, then studied him for a moment. "You look like someone who hasn't decided what he wants yet."

There was something direct about her confidence.`,
 choices:[
  {label:"I haven\'t. I\'m figuring it out.",effect:{trust:1},next:"luna_test"},
  {label:"I know exactly what I want.",effect:{courage:1},next:"luna_test"},
  {label:"Ask why she's watching everyone.",effect:{reputation:1},next:"luna_test"}
 ]},
observe:{
 speaker:"Narrator",title:"First Impression",
 text:`Steven stayed back.

He noticed that the woman in black seemed to know several people. Nobody interrupted her. Nobody seemed to need to.

When she finally looked directly at him, Steven realized she had noticed him much earlier.`,
 choices:[
  {label:"Give a small wave.",effect:{trust:1},next:"meet"},
  {label:"Leave before she can approach.",effect:{courage:-1},next:"dorm"}
 ]},
luna_test:{
 speaker:"Luna",title:"A Question",
 text:`Luna smiled.

"Good. Then here's your first decision. You can spend university trying to impress everyone, or you can learn what actually matters to you."

She pauses.

"Which sounds more interesting?"`,
 choices:[
  {label:"Learning what matters to me.",effect:{trust:2},next:"club"},
  {label:"Becoming someone people notice.",effect:{reputation:2},next:"club"},
  {label:"I\'m not sure yet.",effect:{courage:1},next:"club"}
 ]},
club:{
 speaker:"Luna",title:"After Dark",
 text:`A few days later, Luna mentioned a private student social club.

"It's not secret," she said. "It's simply not advertised."

The club explored performance, fashion, identity, confidence, and consensual adult power dynamics. Everyone had boundaries, and everyone was expected to respect them.

Luna looked at Steven.

"You can come as an observer. You don't owe anyone a performance."`,
 choices:[
  {label:"Go with Luna.",effect:{trust:2,reputation:1},next:"first_night"},
  {label:"Ask questions before deciding.",effect:{courage:1},next:"boundaries"},
  {label:"Decline for now.",effect:{reputation:-1},next:"dorm"}
 ]},
boundaries:{
 speaker:"Luna",title:"Boundaries",
 text:`Luna answers every question without teasing him.

"Consent is not a mood. It's a condition. Either person can stop. Either person can change their mind. And nobody gets to pressure somebody else."

She hands him a small card listing the club's rules.`,
 choices:[
  {label:"Keep the card and attend.",effect:{trust:2},next:"first_night"},
  {label:"Thank her and wait.",effect:{courage:1},next:"dorm"}
 ]},
first_night:{
 speaker:"Narrator",title:"The Club",
 text:`The club occupies an old studio above a theatre.

Music plays quietly. People are dressed in everything from ordinary streetwear to elaborate alternative fashion.

Nobody laughs at anyone else's choices.

Luna notices Steven looking at a rack of dramatic clothes prepared for a costume exercise.`,
 choices:[
  {label:"Try a different outfit for the exercise.",effect:{courage:2},next:"outfit"},
  {label:"Stay in your usual clothes.",effect:{reputation:1},next:"pet_intro"},
  {label:"Ask Luna what she recommends.",effect:{trust:2},next:"luna_outfit"}
 ]},
luna_outfit:{
 speaker:"Luna",title:"Her Choice",
 text:`Luna selects a dark, tailored outfit with subtle gothic details.

"Confidence isn't about pretending to be someone else," she says. "It's about being comfortable enough to experiment."

Steven changes and looks at himself in the mirror.`,
 choices:[
  {label:"Commit to the look.",effect:{courage:2,trust:1},next:"pet_intro"},
  {label:"Laugh and change back.",effect:{courage:1},next:"pet_intro"}
 ]},
outfit:{
 speaker:"Narrator",title:"Experiment",
 text:`Steven chooses something outside his normal style.

For a moment he feels self-conscious. Then someone compliments the styling.

The surprise isn't that other people accept it.

The surprise is that Steven likes the feeling of trying something new.`,
 choices:[
  {label:"Own it.",effect:{courage:3,reputation:1},next:"pet_intro"},
  {label:"Keep it low-key.",effect:{courage:1},next:"pet_intro"}
 ]},
pet_intro:{
 speaker:"Luna",title:"A Different Kind of Play",
 text:`Later, Luna explains another part of the club's culture: consensual role-play involving animal-inspired behavior and playful obedience.

"Some people call it pet-play," she says. "It's role-play, not ownership of a real person. Rules and safewords come first."

She looks at Steven.

"You don't have to participate."`,
 choices:[
  {label:"Ask how it works.",effect:{trust:2},next:"pet_rules"},
  {label:"Say you're curious but want to watch.",effect:{courage:1},next:"ending_path"},
  {label:"Decide it's not for you.",effect:{reputation:1},next:"ending_path"}
 ]},
pet_rules:{
 speaker:"Luna",title:"Rules First",
 text:`Luna explains the basics: negotiate beforehand, establish boundaries, choose a safeword, and check in during and after the scene.

"No surprises," she says. "The interesting part is the trust."

Steven realizes that the club isn't really about following a single script. It's about discovering what he is comfortable with.`,
 choices:[
  {label:"Tell Luna you trust her enough to explore slowly.",effect:{trust:3,submission:1},next:"ending_path"},
  {label:"Tell her you want to set your own pace.",effect:{courage:2,trust:1},next:"ending_path"}
 ]},
dorm:{
 speaker:"Narrator",title:"Room to Think",
 text:`Back in his room, Steven thinks about the week.

University suddenly feels less like a place where he has to become someone else and more like a place where he can decide who he wants to become.

His phone lights up.

A message from Luna: "Next week. Same place?"`,
 choices:[
  {label:"Reply: "Yes."",effect:{trust:1},next:"ending_path"},
  {label:"Reply: "Maybe."",effect:{courage:1},next:"ending_path"}
 ]},
ending_path:{
 speaker:"Narrator",title:"The First Chapter",
 text:`The first week ends without Steven having all the answers.

But he has learned three things: curiosity is not commitment, boundaries matter, and confidence can be practiced.

Luna's message remains on his screen.

Whatever happens next, Steven knows it will be a choice.`,
 choices:[
  {label:"Start the next chapter.",effect:{},next:"intro",day:true},
  {label:"Return to the title screen.",effect:{},next:"menu"}
 ]}
};

function load(){try{return JSON.parse(localStorage.getItem(KEY))}catch(e){return null}}
function save(){localStorage.setItem(KEY,JSON.stringify(state));toast("Game saved.");}
function reset(){if(confirm("Start a new game? Your current save will be replaced.")){state=baseState();render();}}
function toast(msg){let t=document.createElement("div");t.textContent=msg;t.style="position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#27202f;color:#fff;padding:10px 14px;border-radius:10px;border:1px solid #493958;z-index:5";document.body.appendChild(t);setTimeout(()=>t.remove(),1500)}
function apply(effect){
 if(!effect)return;
 for(const [k,v] of Object.entries(effect)){if(k in state)state[k]+=v}
}
function choose(c){
 apply(c.effect);
 if(c.day)state.day++;
 state.history.push(state.scene);
 state.scene=c.next;
 if(c.next==="menu"){render();return}
 saveSilent();render();
}
function saveSilent(){localStorage.setItem(KEY,JSON.stringify(state))}
function menu(){
 document.getElementById("root").innerHTML=`
 <div class="card"><div class="hero"><div class="portrait">N</div><div class="label">Choice-driven adult drama</div></div>
 <div class="content"><div class="speaker">Nightbound</div><div class="title">A story about choice, identity & power</div>
 <div class="text">Steven's first semester is only beginning. Meet Luna, discover new social circles, experiment with identity, and decide what kind of person Steven becomes.</div>
 <div class="menu"><button class="primary" onclick="newGame()">New Game</button>${localStorage.getItem(KEY)?'<button class="secondary" onclick="continueGame()">Continue</button>':''}</div>
 <div class="note">All characters are adults. Themes are handled through consensual, negotiated role-play and relationship choices.</div></div></div>`;
}
function newGame(){state=baseState();state.scene="intro";render()}
function continueGame(){state=load()||baseState();render()}
function render(){
 if(state.scene==="menu"){menu();return}
 const s=scenes[state.scene]||scenes.intro;
 document.getElementById("day").textContent=`Day ${state.day}`;
 document.getElementById("root").innerHTML=`
 <div class="stats">
  <div class="stat"><b>${state.courage}</b><span>Courage</span></div>
  <div class="stat"><b>${state.trust}</b><span>Trust</span></div>
  <div class="stat"><b>${state.submission}</b><span>Submission</span></div>
  <div class="stat"><b>${state.reputation}</b><span>Reputation</span></div>
 </div>
 <div class="card"><div class="hero"><div class="portrait">${s.speaker==="Luna"?"L":"S"}</div><div class="label">Scene ${state.history.length+1}</div></div>
 <div class="content"><div class="speaker">${esc(s.speaker)}</div><div class="title">${esc(s.title)}</div><div class="text">${esc(s.text)}</div>
 <div class="choices">${s.choices.map((c,i)=>`<button class="choice" onclick="choose(scenes['${state.scene}'].choices[${i}])">${esc(c.label)}<small>${effectText(c.effect)}</small></button>`).join("")}</div>
 <div class="toolbar"><button class="tool" onclick="save()">Save</button><button class="tool" onclick="loadAndRender()">Load</button><button class="tool" onclick="menu()">Menu</button></div>
 </div></div>`;
}
function loadAndRender(){state=load()||state;render();toast("Game loaded.")}
function effectText(e){if(!e)return"";return Object.entries(e).filter(([k,v])=>k!=="").map(([k,v])=>`${k}: ${v>0?"+":""}${v}`).join(" · ")}
function esc(x){return String(x).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
render();
</script>
</body>
  </html>
